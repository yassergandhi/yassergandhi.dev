---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import PurpleSquirrel from '../components/PurpleSquirrel.astro';
import Project from '../components/Project.astro';
import Adr from '../components/Adr.astro';
import Credentials from '../components/Credentials.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Yasser Gandhi — Friction Scan Consulting",
  "description": "SaaS onboarding architecture audits for Series A–C companies where trial-to-paid conversion is flat and activation analytics don't explain why. Friction Scan methodology. Mexico City, remote.",
  "url": "https://yassergandhi.dev",
  "email": "yassergandhi.dev@gmail.com",
  "founder": {
    "@type": "Person",
    "name": "Yasser Gandhi Hernández Esquivel",
    "jobTitle": "SaaS Onboarding Architect · Friction Scan Consulting",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Mexico City",
      "addressCountry": "MX"
    }
  },
  "serviceType": [
    "Friction Scan Audit",
    "SaaS Onboarding Architecture Diagnosis",
    "Trial-to-Paid Conversion Analysis",
    "Activation Failure Diagnosis",
    "User Retention Engineering"
  ],
  "areaServed": "Worldwide",
  "availableChannel": {
    "@type": "ServiceChannel",
    "serviceUrl": "mailto:yassergandhi.dev@gmail.com"
  }
});
---

<Layout
  title="Yasser Gandhi · SaaS Onboarding Architect · Diagnose Why Users Leave Before Activation"
  description="Your trial-to-paid conversion is flat and your onboarding analytics show where users leave — but not why the architecture makes them leave. I diagnose the structural failures in SaaS onboarding flows that event logs cannot surface. Friction Scan Consulting, Mexico City."
  keywords="Friction Scan, SaaS Onboarding Architect, Trial-to-Paid Conversion, Activation Failure, User Retention Consulting, Onboarding Architecture, Software Churn, User Attrition, B2B SaaS Consulting, Information Architecture, Cognitive Scaffolding, LTV Protection, Product Adoption Engineering, Series A SaaS"
>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <Nav />
  <main>
    <Hero />
    <hr class="divider" />
    <PurpleSquirrel />
    <hr class="divider" />
    <Project />
    <hr class="divider" />
    <Adr />
    <hr class="divider" />
    <Credentials />
    <hr class="divider" />
    <About />
    <hr class="divider" />
    <Contact />
  </main>
</Layout>
