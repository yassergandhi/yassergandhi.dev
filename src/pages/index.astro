---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import FoundationalScene from "../components/FoundationalScene.astro";
import CentralQuestion from "../components/CentralQuestion.astro";
import FirstSolution from "../components/FirstSolution.astro";
import HowItWorksSection from "../components/HowItWorksSection.astro";
import OfferSection from "../components/OfferSection.astro";
import ExperienceEvidence from "../components/ExperienceEvidence.astro";
import TrustSection from "../components/TrustSection.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const canonical = "https://yassergandhi.dev/";
const description =
  "No empiezo por la página. Reconstruyo qué ocurrió, quién todavía podía ayudar y qué sitio o sistema hace falta construir.";

const schema = [
  {
    "@type": "Person",
    "@id": `${canonical}#person`,
    name: "Yasser Gandhi Hernández Esquivel",
    url: canonical,
    email: "mailto:yassergandhi.dev@gmail.com",
    jobTitle: "Docente-investigador y desarrollador de sistemas web",
    affiliation: {
      "@type": "Organization",
      name: "CELEX — Centro de Lenguas Extranjeras, UAM Azcapotzalco",
    },
    alumniOf: [
      {
        "@type": "CollegeOrUniversity",
        name: "Universidad Nacional Autónoma de México",
      },
      {
        "@type": "CollegeOrUniversity",
        name: "Universidad de Guadalajara",
      },
    ],
    hasCredential: [
      {
        "@type": "EducationalOccupationalCredential",
        name: "Licenciatura en Lengua y Literaturas Modernas (Letras Alemanas)",
        credentialCategory: "Licenciatura",
      },
      {
        "@type": "EducationalOccupationalCredential",
        name: "Maestría en Pedagogía",
        credentialCategory: "Maestría",
      },
      {
        "@type": "EducationalOccupationalCredential",
        name: "Licenciatura en Desarrollo de Sistemas Web",
        credentialCategory: "Licenciatura",
      },
    ],
    sameAs: [
      "https://www.linkedin.com/in/yassergandhi/",
      "https://github.com/yassergandhi/",
      "https://orcid.org/0000-0002-8736-184X",
      "https://scholar.google.com/citations?user=YnqLK4oAAAAJ",
    ],
    subjectOf: [
      {
        "@type": "CreativeWork",
        name: "Trayectoria de investigación",
        url: "https://huhugerman.com/investigacion",
      },
      {
        "@type": "Dataset",
        name: "Corpus CELEX-UAM Azcapotzalco 2026",
        url: "https://osf.io/b7895/overview",
      },
    ],
  },
  {
    "@type": "WebSite",
    "@id": `${canonical}#website`,
    name: "yassergandhi.dev",
    url: canonical,
    inLanguage: "es-MX",
    publisher: { "@id": `${canonical}#person` },
  },
  {
    "@type": "ProfessionalService",
    "@id": `${canonical}#professional-service`,
    name: "yassergandhi.dev",
    url: canonical,
    areaServed: ["Ciudad de México", "Remoto"],
    founder: { "@id": `${canonical}#person` },
    description,
  },
  {
    "@type": "Service",
    "@id": `${canonical}#service`,
    name: "Proyecto de sitio o sistema web con investigación cualitativa",
    serviceType: "Proyecto de sitio o sistema web con investigación cualitativa",
    provider: { "@id": `${canonical}#professional-service` },
    areaServed: ["Ciudad de México", "Remoto"],
    description,
  },
];
---

<Layout
  title="Sitios y sistemas web con investigación cualitativa | Yasser Gandhi"
  {description}
  {canonical}
  ogTitle="Tu negocio no empezó con una página."
  ogDescription="Empezó con una vida que alguien quería construir. Primero pregunto, después reconstruyo y sólo entonces construyo."
  ogImageAlt="Tu negocio no empezó con una página. Empezó con una vida que alguien quería construir."
  extraSchema={schema}
>
  <Nav />

  <main>
    <Hero />
    <FoundationalScene />
    <CentralQuestion />
    <FirstSolution />
    <HowItWorksSection />
    <OfferSection />
    <ExperienceEvidence />
    <TrustSection />
    <Contact />
  </main>

  <Footer />
</Layout>
