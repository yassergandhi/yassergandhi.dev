---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProblemSection from '../components/ProblemSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import DiagnosticTerminal from '../components/DiagnosticTerminal.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import MeasurableSignals from '../components/MeasurableSignals.astro';
import AuthoritySection from '../components/AuthoritySection.astro';
import LivingLabSection from '../components/LivingLabSection.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const title = 'yassergandhi.dev — SaaS Guidance Failure & Feedback Architecture';
const description = 'Diagnose where SaaS users stop acting across onboarding, support, forms and handoffs. Turn recurring confusion into feedback, activation and next action.';
const canonical = 'https://yassergandhi.dev/';
const ogTitle = 'Find where your users stop acting — before support absorbs the cost.';
const ogDescription = 'Qualitative friction analysis for SaaS onboarding, support, forms and handoffs.';

const credentials = [
  { '@type': 'EducationalOccupationalCredential', name: 'B.A. Modern German Language and Literature', credentialCategory: 'degree', recognizedBy: { '@type': 'CollegeOrUniversity', name: 'Universidad Nacional Autónoma de México' } },
  { '@type': 'EducationalOccupationalCredential', name: 'M.A. Pedagogy', credentialCategory: 'degree', recognizedBy: { '@type': 'CollegeOrUniversity', name: 'Universidad Nacional Autónoma de México' } },
  { '@type': 'EducationalOccupationalCredential', name: 'B.Sc. Web Systems Development', credentialCategory: 'degree', recognizedBy: { '@type': 'CollegeOrUniversity', name: 'Universidad de Guadalajara' } },
];

const personSchema = {
  '@type': 'Person', '@id': 'https://yassergandhi.dev/#person', name: 'Yasser Gandhi Hernández Esquivel', url: canonical,
  sameAs: ['https://www.linkedin.com/in/yassergandhi/','https://github.com/yassergandhi/','https://huhugerman.com'],
  jobTitle: 'SaaS friction analysis and feedback architecture consultant',
  description: 'Qualitative friction research, feedback design and web systems for SaaS onboarding, support, forms and handoffs.',
  knowsAbout: ['SaaS onboarding','Customer Success','support friction','handoff gaps','qualitative friction analysis','feedback architecture','product adoption','implementation workflows','TypeScript','Astro'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universidad Nacional Autónoma de México' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad de Guadalajara' },
  ],
  hasCredential: credentials,
};
const websiteSchema = { '@type': 'WebSite', '@id': 'https://yassergandhi.dev/#website', name: 'yassergandhi.dev', url: canonical, description, publisher: { '@id': 'https://yassergandhi.dev/#person' } };
const serviceSchema = { '@type': 'Service', '@id': 'https://yassergandhi.dev/#support-friction-audit', name: 'Support Friction Audit', serviceType: 'Qualitative friction analysis for SaaS onboarding, support, forms and handoffs', provider: { '@id': 'https://yassergandhi.dev/#person' }, areaServed: 'Global', audience: { '@type': 'BusinessAudience', audienceType: 'B2B SaaS, Customer Success, Implementation, Support and Product Education teams' }, description, offers: { '@type': 'Offer', availability: 'https://schema.org/InStock', url: canonical } };
const aboutPageSchema = { '@type': 'AboutPage', '@id': 'https://yassergandhi.dev/#authority', url: canonical, name: 'SaaS friction analysis proof', about: { '@id': 'https://yassergandhi.dev/#person' }, isPartOf: { '@id': 'https://yassergandhi.dev/#website' } };
---
<Layout {title} {description} {canonical} {ogTitle} {ogDescription} extraSchema={[personSchema, websiteSchema, serviceSchema, aboutPageSchema, ...credentials]}>
  <Nav />
  <main>
    <Hero />
    <ProblemSection />
    <ServicesSection />
    <DiagnosticTerminal />
    <HowItWorksSection />
    <MeasurableSignals />
    <AuthoritySection />
    <LivingLabSection />
    <Contact />
  </main>
  <Footer />
</Layout>
