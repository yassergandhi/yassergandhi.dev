---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import TallyEvaluation from "../components/TallyEvaluation.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="Evaluación inicial del caso | yassergandhi.dev" description="Describe una situación concreta para determinar si existe un caso investigable y qué información hace falta antes de definir alcance e inversión." canonical="https://yassergandhi.dev/evaluacion" noindex>
  <Nav /><main class="evaluation-page">
    <header class="evaluation-header"><div class="container reading"><p class="kicker">Evaluación inicial del caso</p><h1>Describe una situación concreta para saber si existe un caso investigable.</h1><p class="lead">No empieces por la solución. Describe qué ocurrió, qué se respondió, qué tuvo que explicarse otra vez y en qué momento dejó de avanzar.</p></div></header>
    <section class="section-alt"><div class="container evaluation-grid"><div><h2>Qué es</h2><p>Una revisión inicial para decidir si existe base para continuar.</p></div><div><h2>Qué no es</h2><p>No es cotización, auditoría gratuita, diagnóstico completo ni aceptación automática.</p></div><div><h2>Qué puede ocurrir después</h2><ul class="plain-list"><li>el caso corresponde y se agenda una conversación;</li><li>hace falta otra decisión o más información;</li><li>el caso requiere otro tipo de apoyo;</li><li>no conviene construir todavía.</li></ul></div></div></section>
    <section class="tally-section" aria-labelledby="tally-heading"><div class="container reading"><h2 id="tally-heading">Describe la situación</h2><p>Describe un caso real de forma general. No compartas contraseñas, datos financieros, expedientes ni información sensible.</p><TallyEvaluation /></div></section>
  </main><Footer />
</Layout>
