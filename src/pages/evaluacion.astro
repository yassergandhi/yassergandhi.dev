---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import TallyEvaluation from "../components/TallyEvaluation.astro";
import Footer from "../components/Footer.astro";
---
<Layout
  title="Revisión inicial de un caso | Yasser Gandhi"
  description="Cuenta un caso reciente en el que alguien mostró interés y después no supiste qué pasó. La revisión inicial toma dos minutos."
  canonical="https://yassergandhi.dev/evaluacion"
  ogTitle="Revisemos un caso reciente"
  ogDescription="Cuenta un momento reciente. No necesitas explicar todo tu negocio ni saber cuál es el problema."
  noindex
>
  <Nav />
  <main class="evaluation-page">
    <header class="evaluation-header">
      <div class="container evaluation-reading">
        <p class="kicker">Revisión inicial</p>
        <h1>Cuéntame la última vez que alguien mostró interés y después no supiste qué pasó.</h1>
        <p class="intro-copy">Puede haber llegado por recomendación, Facebook, Google Maps, una búsqueda o tu página. No necesitas explicar todo tu negocio: sólo cuenta un caso reciente.</p>
        <p class="evaluation-strip" aria-label="Información de la revisión">2 minutos <span>·</span> tus datos van al final <span>·</span> te responderé por el medio que elijas</p>
      </div>
    </header>
    <section class="tally-section" aria-labelledby="tally-heading">
      <div class="container evaluation-reading">
        <h2 id="tally-heading" class="visually-hidden">Formulario para revisar un caso reciente</h2>
        <p class="sensitive-note">Describe el caso de forma general. No compartas contraseñas, datos financieros, expedientes ni información sensible.</p>
        <TallyEvaluation />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
