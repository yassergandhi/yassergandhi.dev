---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import TallyEvaluation from "../components/TallyEvaluation.astro";
import Footer from "../components/Footer.astro";
---
<Layout
  title="Cuéntame qué pasó | Yasser Gandhi"
  description="Piensa en la última persona que mostró interés. Cuéntame cómo llegó, qué preguntó y qué ocurrió después."
  canonical="https://yassergandhi.dev/evaluacion"
  ogTitle="Piensa en la última persona que mostró interés"
  ogDescription="Cuéntame cómo llegó, qué preguntó y qué ocurrió después."
  noindex
>
  <Nav />
  <main class="evaluation-page">
    <header class="evaluation-header">
      <div class="container evaluation-reading">
        <p class="kicker">Cuéntame qué pasó</p>
        <h1>Piensa en la última persona que mostró interés.</h1>
        <p class="intro-copy">¿Cómo llegó, qué preguntó y qué ocurrió después? No necesitas explicar todo tu negocio ni descubrir el problema antes de empezar.</p>
        <p class="evaluation-strip" aria-label="Información de la revisión">2 minutos <span>·</span> tus datos van al final <span>·</span> te respondo por el medio que elijas</p>
      </div>
    </header>
    <section class="tally-section" aria-labelledby="tally-heading">
      <div class="container evaluation-reading">
        <h2 id="tally-heading" class="visually-hidden">Formulario para revisar un caso reciente</h2>
        <p class="sensitive-note">Cuenta el caso de forma general. No compartas nombres, contraseñas, datos bancarios, expedientes ni información sensible.</p>
        <TallyEvaluation />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
