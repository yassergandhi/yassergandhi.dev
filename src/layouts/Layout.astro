---
import '../styles/global.css';

const siteUrl = 'https://yassergandhi.dev';
const defaultTitle = 'Guidance Failure Architecture for SaaS · Yasser Gandhi';
const defaultDescription = 'Hidden Scaffold Reviews for SaaS flows where users stop, guess, abandon, submit bad data, or push missing guidance into support.';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  noindex?: boolean;
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = defaultTitle,
  description = defaultDescription,
  canonical = `${siteUrl}/`,
  ogTitle = title,
  ogDescription = description,
  ogImage = `${siteUrl}/og-image.svg`,
  ogImageAlt = 'Guidance Failure Architecture by Yasser Gandhi',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  noindex = false,
  extraSchema,
} = Astro.props;

const schemaGraph = Array.isArray(extraSchema) ? extraSchema : extraSchema ? [extraSchema] : [];
const jsonLd = schemaGraph.length > 0 ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaGraph }) : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Ubuntu+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Yasser Gandhi Hernández Esquivel" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="yassergandhi.dev" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <div class="aura"></div>
    <slot />
  </body>
</html>
