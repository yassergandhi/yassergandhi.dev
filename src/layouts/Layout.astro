---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";

const siteUrl = "https://yassergandhi.dev";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  extraSchema?: Record<string, unknown>[];
}

const {
  title = "Sitios y sistemas web con investigación cualitativa | yassergandhi.dev",
  description = "Reconstruyo cómo llega una persona, qué espera y dónde pierde continuidad. Después decidimos si conviene cambiar una página, construir un sistema o no construir todavía.",
  canonical = `${siteUrl}/`,
  ogTitle = "La promesa abre la puerta. El sistema debe permitir continuar.",
  ogDescription = "Investigo qué esperaba una persona, qué encontró y qué tuvo que reparar para avanzar. Después decidimos qué construir.",
  ogImage = `${siteUrl}/og-image.png`,
  ogImageAlt = "La promesa abre la puerta. El sistema debe permitir continuar.",
  noindex = false,
  extraSchema = [],
} = Astro.props;

const jsonLd = extraSchema.length
  ? JSON.stringify({ "@context": "https://schema.org", "@graph": extraSchema })
  : "";
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,600..800&family=Instrument+Sans:wdth,wght@75..100,400..700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Yasser Gandhi Hernández Esquivel" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="yassergandhi.dev" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="build-sha" content={import.meta.env.VERCEL_GIT_COMMIT_SHA || "local"} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="aura"></div>
    <slot />
    <Analytics />
  </body>
</html>
