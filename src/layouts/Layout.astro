---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = 'Yasser Gandhi · SaaS Onboarding Architect · Diagnose Why Users Leave Before Activation',
  description = 'Your trial-to-paid conversion is flat and your onboarding analytics show where users leave — but not why the architecture makes them leave. I diagnose the structural failures in SaaS onboarding flows that event logs cannot surface. Friction Scan Consulting, Mexico City.',
  keywords = 'Friction Scan, SaaS Onboarding Architect, Trial-to-Paid Conversion, Activation Failure, User Retention Consulting, Onboarding Architecture, Software Churn, User Attrition, B2B SaaS Consulting, Information Architecture, Cognitive Scaffolding, LTV Protection, Product Adoption Engineering, Series A SaaS',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Ubuntu+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Yasser Gandhi Hernández Esquivel" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://yassergandhi.dev/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <slot name="head" />
  </head>

  <body>
    <div class="aura"></div>
    <slot />
  </body>
</html>
