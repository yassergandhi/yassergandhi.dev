---
const services = [
  {
    title: 'Support Friction Audit',
    audience: 'For teams answering the same questions every week.',
    deliverables: ['repeated question map', 'support ticket themes', 'guidance gaps', 'prevention copy', 'prioritized fixes'],
    cta: 'Request a support friction audit',
  },
  {
    title: 'Onboarding Breakpoint Review',
    audience: 'For products where users finish onboarding but fail to activate.',
    deliverables: ['breakpoint map', 'hidden assumptions', 'first-action analysis', 'onboarding copy recommendations', 'activation events to track'],
    cta: 'Review one onboarding flow',
  },
  {
    title: 'Intake & Handoff Diagnostic',
    audience: 'For teams where Sales, Implementation or CS receive incomplete context.',
    deliverables: ['intake question redesign', 'handoff gap map', 'user readiness signals', 'risk flags', 'CS handoff brief'],
    cta: 'Fix one intake or handoff',
  },
  {
    title: 'Feedback Architecture Sprint',
    audience: 'Premium offer for teams with recurring friction that needs a reusable response system.',
    deliverables: ['feedback library', 'CS scripts', 'onboarding emails', 'post-error messages', 'escalation rules', 'implementation guidance'],
    cta: 'Build a feedback system',
  },
];

const href = 'mailto:yassergandhi.dev@gmail.com?subject=Friction%20Audit%20Inquiry';
---

<section id="services">
  <div class="container">
    <p class="section-label">Services</p>
    <div class="section-heading-row">
      <h2>Start with one friction point.</h2>
      <p>One flow, one repeated support issue, one broken handoff, or one onboarding gap.</p>
    </div>
    <div class="service-grid">
      {services.map((service) => (
        <article class="service-card">
          <h3>{service.title}</h3>
          <p>{service.audience}</p>
          <ul>
            {service.deliverables.map((item) => <li>{item}</li>)}
          </ul>
          <a href={href} class="service-link">{service.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>
