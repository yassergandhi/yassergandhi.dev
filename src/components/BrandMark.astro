---
interface Props {
  decorative?: boolean;
  class?: string;
  label?: string;
  monochrome?: boolean;
}

const {
  decorative = true,
  class: className = "",
  label = "Y de yassergandhi.dev: dos caminos y una decisión",
  monochrome = false,
} = Astro.props;
---
<svg
  class:list={["brand-mark", className]}
  viewBox="0 0 120 120"
  role={decorative ? undefined : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : label}
  data-monochrome={monochrome ? "" : undefined}
  focusable="false"
>
  <path class="brand-mark-body" d="M8 10h24l28 37 18-18 17 4-25 37v42H50V70Z" fill="currentColor"/>
  <path class="brand-mark-body brand-mark-branch" d="M91 10h21l-11 15-17-4Z" fill="currentColor"/>
  <path class="brand-mark-piece" d="m80 25 19 4-3 9-19-4Z"/>
</svg>
