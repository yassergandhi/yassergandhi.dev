---
const links = [
  {
    label: "Correo",
    href: "mailto:yassergandhi.dev@gmail.com",
    external: false,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/yassergandhi/",
    external: true,
  },
  {
    label: "GitHub",
    href: "https://github.com/yassergandhi/",
    external: true,
  },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-identity">
      <strong>Yasser Gandhi Hernández Esquivel</strong>
      <p>
        Sitios y sistemas web<br />
        con investigación cualitativa.
      </p>
      <p class="footer-meta">Ciudad de México · Remoto</p>
    </div>

    <nav class="footer-links" aria-label="Contacto y perfiles">
      {
        links.map((link) => (
          <a
            class="footer-link"
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))
      }

      <a
        class="footer-link"
        href="/evaluacion?originPage=home&offer=evaluacion_inicial"
      >
        Evaluación
      </a>
    </nav>

    <aside class="footer-project" aria-labelledby="footer-project-title">
      <p class="section-label">Proyecto autoral relacionado</p>

      <h2 id="footer-project-title">huhuGERMAN</h2>

      <p>
        Preparación situada para Alemania, nacida de investigación y
        experiencia vivida.
      </p>

      <a
        class="footer-research-link"
        href="https://huhugerman.com/investigacion"
        target="_blank"
        rel="noopener noreferrer"
      >
        Investigación y trayectoria
      </a>
    </aside>

    <p class="footer-terminal">
      <span>
        Primero pregunto.<br />
        Después reconstruyo.<br />
        Sólo entonces construyo.
      </span>
    </p>
  </div>
</footer>

<style>
  .footer-research-link {
    position: relative;
    display: inline-block;
    width: fit-content;
    text-decoration: none;
  }

  .footer-research-link::after {
    position: absolute;
    right: 0;
    bottom: -0.18em;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .footer-research-link:hover::after,
  .footer-research-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .footer-research-link:focus-visible {
    border-radius: 0.1rem;
    outline: 2px solid #ff5a1f;
    outline-offset: 0.35rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-research-link::after {
      transition: none;
    }
  }
</style>
