---
const links = [
  {
    label: "Correo",
    href: "mailto:yassergandhi.dev@gmail.com",
    external: false,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/yassergandhi/",
    external: true,
  },
  {
    label: "GitHub",
    href: "https://github.com/yassergandhi/",
    external: true,
  },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-identity">
      <strong>Yasser Gandhi Hernández Esquivel</strong>
      <p>
        Sitios y sistemas web<br />
        con investigación cualitativa.
      </p>
      <p class="footer-meta">Ciudad de México · Remoto</p>
    </div>

    <nav class="footer-links" aria-label="Contacto y perfiles">
      {
        links.map((link) => (
          <a
            class="footer-link"
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))
      }

      <a
        class="footer-link"
        href="/evaluacion?originPage=home&offer=evaluacion_inicial"
      >
        Evaluación
      </a>
    </nav>

    <aside class="footer-project" aria-labelledby="footer-project-title">
      <p class="section-label">Proyecto autoral relacionado</p>

      <h2 id="footer-project-title">
        <a
          href="https://huhugerman.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          huhuGERMAN
        </a>
      </h2>

      <p>
        Preparación situada para Alemania, nacida de investigación y
        experiencia vivida.
      </p>

      <a
        href="https://huhugerman.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        Conocer huhuGERMAN
      </a>
    </aside>

    <p class="footer-terminal">
      <span>
        Primero pregunto.<br />
        Después reconstruyo.<br />
        Sólo entonces construyo.
      </span>
    </p>
  </div>
</footer>
