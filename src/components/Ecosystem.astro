---
const items = [
  {
    title: 'yassergandhi.dev',
    thesis: 'Product stops guiding -> operational cost.',
    href: '/',
    status: 'live',
    className: 'site',
  },
  {
    title: 'huhuGERMAN',
    thesis: 'Classroom stops guiding -> German becomes consequence.',
    href: 'https://huhugerman.com',
    status: 'live proof',
    className: 'huhu',
  },
  {
    title: 'Fernweh Together',
    thesis: 'Platform only gives a link -> shared experience disappears.',
    href: '',
    status: 'forthcoming',
    className: 'fernweh',
  },
];
---
<section id="ecosystem">
  <div class="container">
    <div class="section-label">Ecosystem</div>
    <h2>One authorial signature, three contexts where guidance disappears.</h2>
    <p class="section-copy">The proof is the same reading discipline applied across product systems, language systems, and shared experience systems.</p>
    <div class="ecosystem-map" aria-label="Authorial ecosystem map">
      <div class="ecosystem-center">Where the system stops guiding</div>
      {items.map((item) => item.href ? (
        <a class={`ecosystem-node ${item.className}`} href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}>
          <span class="status-pill">
            <span aria-hidden="true"></span>
            {item.status}
          </span>
          <strong>{item.title}</strong>
          <span>{item.thesis}</span>
        </a>
      ) : (
        <div class={`ecosystem-node ${item.className} is-static`}>
          <span class="badge" tabindex="0" aria-describedby="fernweh-status-tip">
            <span aria-hidden="true"></span>
            {item.status}
          </span>
          <span id="fernweh-status-tip" class="tooltip" role="tooltip">Concept stage · not public yet</span>
          <strong>{item.title}</strong>
          <span>{item.thesis}</span>
        </div>
      ))}
    </div>
    <p class="section-copy ecosystem-line">When the system stops guiding, the real design begins.</p>
  </div>
</section>
