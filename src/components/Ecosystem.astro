---
const items = [
  {
    context: 'Product systems',
    title: 'yassergandhi.dev',
    copy: 'Product stops guiding -> operational cost.',
    status: 'live',
    href: '/',
  },
  {
    context: 'Language systems',
    title: 'huhuGERMAN',
    copy: 'Classroom stops guiding -> German becomes consequence.',
    status: 'live proof',
    href: 'https://huhugerman.com',
  },
  {
    context: 'Shared experience systems',
    title: 'Fernweh Together',
    copy: 'Platform only gives a link -> shared experience disappears.',
    status: 'forthcoming',
    href: '',
  },
];
---
<section id="ecosystem">
  <div class="container">
    <div class="section-label">Ecosystem</div>
    <h2>One authorial signature, three contexts where guidance disappears.</h2>
    <p class="section-copy">The same diagnostic gesture appears in three contexts: product systems, language systems, and shared experience systems.</p>
    <div class="ecosystem-relay ecosystem-spine" aria-label="Guidance failure spine">
      <div class="ecosystem-anchor">Where the system stops guiding</div>
      {items.map((item) => item.href ? (
        <a class="ecosystem-link" data-node={item.title} href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}>
          <span class={`status-pill ${item.status === 'live proof' ? 'proof' : 'live'}`}>{item.status}</span>
          <span class="ecosystem-context">{item.context}</span>
          <strong>{item.title}</strong>
          <span>{item.copy}</span>
        </a>
      ) : (
        <div class="ecosystem-link is-static" data-node={item.title}>
          <span class="status-pill forthcoming">{item.status}</span>
          <span class="ecosystem-context">{item.context}</span>
          <strong>{item.title}</strong>
          <span>{item.copy}</span>
        </div>
      ))}
    </div>
    <p class="section-copy ecosystem-line">When the system stops guiding, the real design begins.</p>
  </div>
</section>
