---
const notFor = ['no real users','no observable breakdown','no internal cost','no owner willing to act','only visual polish requested'];
---
<section id="fit">
  <div class="container fit-layout">
    <div>
      <div class="section-label">Fit</div>
      <h2>Who this is not for.</h2>
      <ul class="not-for-list">{notFor.map((item) => <li>{item}</li>)}</ul>
    </div>
    <aside class="for-panel">
      <span>For</span>
      <p>teams with a critical flow that already creates support load, bad data, stalled onboarding, unclear qualification, repeated debate, or CS workarounds.</p>
    </aside>
  </div>
</section>
