---
const preview = [
  ['Failure point', 'the moment the user cannot continue confidently'],
  ['Hidden assumption', 'what the product expects too early'],
  ['User workaround', 'what people do when guidance disappears'],
  ['Cost transfer', 'which team now carries the missing scaffold'],
  ['Next scaffold', 'the guidance that must exist before action'],
  ['First intervention', 'what to rewrite, delay, remove, expose, constrain, or implement'],
];
const fullDeliverables = ['the exact point where guidance disappears','what the system assumes the user already knows, trusts, or can decide','what the user likely does instead','which team currently absorbs the cost','what language, sequence, constraint, or missing state causes the breakdown','what scaffold must exist before the next decision','what to rewrite, delay, remove, expose, constrain, or implement'];
---
<section id="offer">
  <div class="container">
    <div class="section-label">Offer</div>
    <h2>Hidden Scaffold Review</h2>
    <div class="project-card offer-card">
      <p class="section-copy">A strategic review of one critical SaaS flow your team cannot afford to keep misreading.</p>
      <p class="section-copy">It identifies where guidance disappears, what the product assumes too early, where the cost is currently being transferred, and what scaffold must exist before the user can act.</p>
      <div class="review-output-preview">
        <h3>A Hidden Scaffold Review returns:</h3>
        <ol>{preview.map(([title, phrase]) => <li><strong>{title}</strong><span>{phrase}</span></li>)}</ol>
      </div>
      <details class="deliverables-details">
        <summary>See full deliverables</summary>
        <ul>{fullDeliverables.map((deliverable) => <li>{deliverable}</li>)}</ul>
      </details>
    </div>
  </div>
</section>
