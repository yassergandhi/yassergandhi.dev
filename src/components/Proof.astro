---
const evidence = [
  'Modern German Language and Literature, UNAM',
  'Pedagogy, UNAM',
  'Web Systems Development, UdeG',
  '15 years observing breakdowns under institutional constraints',
  'huhuGERMAN as live proof of scaffolded experience design',
  'TypeScript, Supabase, Zod, domain contracts, governed AI',
];
---

<section id="proof">
  <div class="container">
    <div class="section-label">Authorial Evidence</div>
    <h2>Verified formation. One reading practice.</h2>
    <div class="cred-grid proof-verification">
      {evidence.map((item) => (
        <div class="cred-card">
          <div class="cred-degree">{item}</div>
        </div>
      ))}
    </div>
  </div>
</section>
