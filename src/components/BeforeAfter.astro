---
const before = ['the team names the same failure differently','support keeps explaining what the product should have made legible','onboarding compensates for weak product guidance','customer success creates workarounds','product keeps adjusting the wrong layer','leadership sees symptoms without a shared diagnosis'];
const after = ['the failure point is named','the hidden product assumption is visible','the cost transfer is mapped','the responsible team can stop guessing','the next scaffold is specified','the first intervention becomes defendable'];
---
<section id="before-after">
  <div class="container">
    <div class="section-label">Before / After</div>
    <h2>What changes after the review.</h2>
    <div class="before-after-grid">
      <div class="comparison-card before"><h3>Before</h3><ul>{before.map((item) => <li>{item}</li>)}</ul></div>
      <div class="comparison-card after"><h3>After</h3><ul>{after.map((item) => <li>{item}</li>)}</ul></div>
    </div>
  </div>
</section>
