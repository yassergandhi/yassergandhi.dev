---
const isEvaluation = Astro.url.pathname.replace(/\/+$/, "") === "/evaluacion";
const links = [
  { label: "Método", href: "/#metodo" },
  { label: "Oferta", href: "/#oferta" },
];
---

<nav class="site-nav" aria-label="Navegación principal">
  <div class="container nav-inner">
    <a
      href="/"
      class="nav-brand"
      aria-label="yassergandhi.dev, inicio"
      aria-current={!isEvaluation ? "page" : undefined}
    >
      yassergandhi.dev<span aria-hidden="true">_</span>
    </a>

    {
      isEvaluation ? (
        <a class="nav-back" href="/">
          Volver al inicio
        </a>
      ) : (
        <>
          <ul class="nav-links">
            {links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
          <a
            class="nav-evaluation"
            href="/evaluacion?originPage=home&offer=evaluacion_inicial"
          >
            Evaluación
          </a>
        </>
      )
    }
  </div>
</nav>
