---
const links = [
  { label: "Método", href: "/#metodo" },
  { label: "Oferta", href: "/#oferta" },
];
---

<nav class="site-nav" aria-label="Navegación principal">
  <div class="container nav-inner">
    <a href="/" class="nav-brand" aria-label="yassergandhi.dev, inicio">
      yassergandhi.dev<span aria-hidden="true">_</span>
    </a>

    <ul class="nav-links nav-desktop">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>

    <details class="nav-mobile">
      <summary aria-label="Abrir menú de navegación"><span>Menú</span></summary>
      <div class="nav-mobile-panel">
        <ul class="nav-links">
          {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
    </details>
  </div>
</nav>
