/* Hero.astro - Ubuntu Lynx Design System */
---

<section id="hero">
  <div class="container">
    <div class="watermark" aria-hidden="true">ARCHITEKT</div>

    <div class="fade-up">
      <div class="hero-label">Learning Systems Architect</div>
    </div>

    <div class="fade-up">
      <h1>Yasser Gandhi</h1>
      <p class="surname">Hernández Esquivel</p>
    </div>

    <div class="fade-up headline-stack">
      <span class="headline-item primary">The Purple Squirrel of EdTech</span>
      <span class="headline-item">AI-Driven Instructional Designer</span>
      <span class="headline-item">German Language Expert · C1 Certified · DaF Specialist</span>
      <span class="headline-item">Systems Engineering · TypeScript · Zod · Domain-Driven Design</span>
      <span class="headline-item">15 Years · UAM & UNAM · Real Users · Real Evidence</span>
    </div>

    <div class="fade-up">
      <p class="hero-summary">
        I design learning systems where <strong>pedagogy governs the AI</strong>, not the other way around. 
        Creator of <strong>huhuGERMAN</strong> — a production-grade platform challenging the field's consensus 
