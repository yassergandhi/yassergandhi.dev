---
const symptoms = [
  ['Design', 'copy that needs another pass'],
  ['Product', 'onboarding friction'],
  ['Support', 'tickets that should not exist'],
  ['Engineering', 'edge cases'],
  ['Customer Success', 'repeated explanation'],
  ['Leadership', 'activation, conversion, or data-quality risk'],
];
---
<section id="recognition">
  <div class="container">
    <div class="section-label">Recognition</div>
    <h2>Your team may already be naming the symptom wrong.</h2>
    <div class="diagnostic-cards">
      {symptoms.map(([team, symptom]) => <div class="metric-card"><span>{team}</span><strong>{symptom}</strong></div>)}
    </div>
    <p class="section-copy">They may all be paying for the same failure from different budgets:</p>
    <div class="method-note">the product asks the user to continue before the next move has been made legible.</div>
    <p class="section-copy recognition-close">That is where the review begins.</p>
  </div>
</section>
