---
const email = 'yassergandhi.dev@gmail.com';
const subject = 'Hidden Scaffold Review Inquiry';
const body = `Product URL:

Flow that breaks:

What users do instead:

What this costs you:

Who inside the team is feeling the pain:

Any evidence available (screenshots, session recordings, support patterns):
`;
const mailto = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const checklist = [
  'Product URL',
  'Flow that breaks',
  'What users do instead',
  'What this costs you',
  'Who inside the team is feeling the pain',
  'Any evidence available (screenshots, session recordings, support patterns)',
];
---

<section id="contact" class="contact-email section-compact">
  <div class="container split-section compact">
    <div>
      <p class="section-label">Contact by email</p>
      <h2>Email the flow your team keeps routing around.</h2>
      <p class="section-copy">Send the pattern first. I will tell you whether it fits a Hidden Scaffold Review.</p>
      <a class="btn-primary" href={mailto}>Send this by email</a>
    </div>
    <div class="email-brief" aria-label="Email brief checklist">
      <p>Include:</p>
      <ul>
        {checklist.map((item) => <li>{item}</li>)}
      </ul>
      <p class="safety-note">Do not send credentials or private customer data in the first email. Describe the pattern first.</p>
    </div>
  </div>
</section>
