<file path="src/components/CostReveal.astro">
---
const costs = [
  {
    front: '$2k-$15k / month',
    label: 'Support-heavy flow',
    back: ['ticket problem', 'support + customer success', 'the missing scaffold keeps moving cost across teams'],
  },
  {
    front: '$10k-$75k / month',
    label: 'Repeated onboarding drag',
    back: ['activation friction', 'implementation + onboarding', 'the same gap gets taught again in every account'],
  },
  {
    front: 'Bad data',
    label: 'Weak intake scaffold',
    back: ['lead quality', 'qualification + sales', 'the form keeps inviting answers nobody can use'],
  },
  {
    front: 'Retention drag',
    label: 'Decision flow without action logic',
    back: ['low engagement', 'product + customer success', 'understanding does not become action'],
  },
];
---

<section id="cost" class="section-focus">
  <div class="container">
    <p class="section-label">Cost of not acting</p>
    <div class="section-heading-row">
      <h2>The cost is already being paid somewhere.</h2>
      <p>These are decision signals, not promises. The question is whether the recurring cost of not diagnosing the flow is already higher than the review.</p>
    </div>
    <div class="metric-card-row">
      {costs.map((cost) => (
        <button class="metric-reveal-card" type="button" aria-expanded="false">
          <span class="metric-front">
            <strong>{cost.front}</strong>
            <em>{cost.label}</em>
          </span>
          <span class="metric-back">
            <span><strong>Misread as:</strong> {cost.back[0]}</span>
            <span><strong>Paid by:</strong> {cost.back[1]}</span>
            <span><strong>If ignored:</strong> {cost.back[2]}</span>
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.metric-reveal-card').forEach((card) => {
    card.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.metric-reveal-card').forEach((item) => {
        if (item !== card) item.setAttribute('aria-expanded', 'false');
      });
      const expanded = card.getAttribute('aria-expanded') === 'true';
      card.setAttribute('aria-expanded', String(!expanded));
    });
  });
</script>
</file>

<file path="src/components/DiagnosticTerminal.astro">
---
const scenarios = [
  {
    id: 'onboarding',
    label: 'onboarding',
    lines: [
      ['symptom', 'users complete onboarding but do not activate'],
      ['translation', 'the next move is not legible'],
      ['hidden assumption', 'user already trusts the request'],
      ['cost transfer', 'support + customer success'],
      ['likely fix', 'sequence + consequence-awareness + decision support'],
    ],
  },
  {
    id: 'intake',
    label: 'intake',
    lines: [
      ['symptom', 'forms arrive complete but unusable'],
      ['translation', 'the product collected answers before it framed judgment'],
      ['hidden assumption', 'user knows what quality looks like'],
      ['cost transfer', 'qualification + implementation'],
      ['likely fix', 'constraint language + examples + refusal states'],
    ],
  },
  {
    id: 'ai',
    label: 'ai-assisted flow',
    lines: [
      ['symptom', 'AI output increases follow-up questions'],
      ['translation', 'confidence is not scaffolded'],
      ['hidden assumption', 'user can evaluate the answer alone'],
      ['cost transfer', 'CS workarounds + expert review'],
      ['likely fix', 'uncertainty markers + handoff rules + next action'],
    ],
  },
  {
    id: 'dashboard',
    label: 'dashboard / decision flow',
    lines: [
      ['symptom', 'users see the data and delay action'],
      ['translation', 'information appears without decision logic'],
      ['hidden assumption', 'user can infer priority'],
      ['cost transfer', 'adoption + retention drag'],
      ['likely fix', 'thresholds + recommendation hierarchy + action states'],
    ],
  },
];
---

<section id="diagnostic">
  <div class="container">
    <p class="section-label">Ubuntu Diagnostic Terminal</p>
    <div class="terminal-shell">
      <div class="terminal-topbar" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <div class="terminal-layout">
        <div class="terminal-tabs" role="tablist" aria-label="Diagnostic scenarios">
          {scenarios.map((scenario, index) => (
            <button class={index === 0 ? 'is-active' : ''} type="button" data-scenario={scenario.id}>{scenario.label}</button>
          ))}
        </div>
        <div class="terminal-output" aria-live="polite">
          {scenarios.map((scenario, index) => (
            <div class={index === 0 ? 'terminal-scenario is-active' : 'terminal-scenario'} data-output={scenario.id}>
              {scenario.lines.map(([key, value]) => (
                <p><span>&gt; {key}:</span> {value}</p>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const terminal = document.querySelector('.terminal-shell');
  const tabs = terminal?.querySelectorAll<HTMLButtonElement>('[data-scenario]');
  const outputs = terminal?.querySelectorAll<HTMLElement>('[data-output]');

  tabs?.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((item) => item.classList.toggle('is-active', item === tab));
      outputs?.forEach((output) => {
        output.classList.toggle('is-active', output.dataset.output === tab.dataset.scenario);
      });
    });
  });
</script>
</file>

