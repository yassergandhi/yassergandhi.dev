<file path="src/styles/global.css">
:root {
  --aubergine: #300a24;
  --aubergine-deep: #170411;
  --aubergine-soft: #4b1237;
  --orange: #e95420;
  --orange-bright: #ff7a3d;
  --green: #4ade80;
  --green-soft: rgba(74, 222, 128, 0.12);
  --cream: #f5f0f0;
  --muted: #c8c0c5;
  --dim: #8f838b;
  --line: rgba(245, 240, 240, 0.12);
  --panel: rgba(23, 4, 17, 0.62);
  --font-main: 'Ubuntu', sans-serif;
  --font-mono: 'Ubuntu Mono', monospace;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

* {
  margin: 0;
}

html {
  scroll-behavior: smooth;
  background: var(--aubergine-deep);
}

body {
  min-height: 100vh;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 82% 14%, rgba(233, 84, 32, 0.1), transparent 18rem),
    radial-gradient(circle at 50% -10%, rgba(122, 32, 80, 0.42), transparent 42rem),
    linear-gradient(180deg, var(--aubergine) 0%, var(--aubergine-deep) 58%);
  color: var(--cream);
  font-family: var(--font-main);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(233, 84, 32, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(233, 84, 32, 0.035) 1px, transparent 1px);
  background-size: 44px 44px;
  mask-image: linear-gradient(to bottom, black, transparent 72%);
}

.aura {
  display: none;
}

a {
  color: inherit;
}

button,
input,
textarea {
  font: inherit;
}

.container {
  position: relative;
  z-index: 1;
  width: min(1120px, calc(100% - 40px));
  margin: 0 auto;
}

section {
  padding: clamp(3.75rem, 7vw, 6.25rem) 0;
}

.section-compact {
  padding: clamp(3rem, 5vw, 4.5rem) 0;
}

nav {
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1px solid rgba(233, 84, 32, 0.16);
  background: rgba(23, 4, 17, 0.82);
  backdrop-filter: blur(16px);
}

nav .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  padding: 1rem 0;
}

.nav-brand,
.nav-links a,
.eyebrow,
.authority-line,
.terminal-tabs button,
.terminal-output {
  font-family: var(--font-mono);
}

.nav-brand {
  color: var(--orange);
  font-size: 0.82rem;
  letter-spacing: 0.12em;
  text-decoration: none;
  text-transform: uppercase;
}

.nav-links {
  display: flex;
  gap: 1.1rem;
  list-style: none;
  padding: 0;
}

.nav-links a {
  color: var(--muted);
  font-size: 0.76rem;
  letter-spacing: 0.05em;
  text-decoration: none;
}

.nav-links a:hover,
.nav-links a:focus-visible {
  color: var(--orange-bright);
}

#hero {
  min-height: min(860px, calc(100vh - 58px));
  display: grid;
  align-items: center;
  padding: clamp(5rem, 11vw, 9rem) 0;
}

.hero-grid {
  max-width: 900px;
}

.eyebrow,
.section-label {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  color: var(--orange-bright);
}

.section-label::after {
  content: '';
  width: min(9rem, 22vw);
  height: 1px;
  background: linear-gradient(90deg, rgba(233, 84, 32, 0.38), transparent);
}

.section-label {
  font-family: var(--font-main);
  font-size: clamp(1rem, 1.2vw, 1.25rem);
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1.2;
  text-transform: none;
}

.eyebrow {
  display: inline-flex;
  margin-bottom: 0.35rem;
  color: var(--orange-bright);
  font-size: clamp(0.95rem, 1.4vw, 1.12rem);
  letter-spacing: 0.08em;
  text-transform: none;
}

.eyebrow::before {
  content: '';
  width: 2.75rem;
  height: 1px;
  background: var(--orange);
  box-shadow: 0 0 18px rgba(233, 84, 32, 0.42);
}

h1,
h2 {
  max-width: 900px;
  color: var(--cream);
  font-weight: 700;
  letter-spacing: 0;
}

h1 {
  margin-top: 1.3rem;
  font-size: clamp(3rem, 7vw, 6.8rem);
  line-height: 0.96;
}

h2 {
  margin-top: 0.85rem;
  font-size: clamp(1.9rem, 3.2vw, 3.35rem);
  line-height: 1.06;
}

h3 {
  color: var(--cream);
  font-size: clamp(1.15rem, 1.5vw, 1.35rem);
  font-weight: 700;
  line-height: 1.18;
}

.hero-subheadline {
  max-width: 720px;
  margin-top: 1.7rem;
  color: var(--muted);
  font-size: clamp(1.18rem, 2vw, 1.55rem);
  line-height: 1.5;
}

.authority-line {
  margin-top: 1.35rem;
  color: var(--orange-bright);
  font-size: 0.92rem;
  letter-spacing: 0.03em;
}

.hero-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  margin-top: 2.5rem;
}

.btn-primary,
.btn-outline {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 0.82rem 1.25rem;
  font-family: var(--font-main);
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  text-decoration: none;
  text-transform: none;
  transition: border-color 0.2s, background 0.2s, color 0.2s, transform 0.2s;
}

.btn-primary {
  border: 1px solid rgba(233, 84, 32, 0.9);
  background: linear-gradient(180deg, var(--orange-bright), var(--orange));
  color: var(--cream);
  box-shadow: 0 0 0 1px rgba(245, 240, 240, 0.04), 0 18px 38px rgba(233, 84, 32, 0.14);
}

.btn-outline {
  border: 1px solid rgba(233, 84, 32, 0.32);
  background: rgba(48, 10, 36, 0.3);
  color: var(--cream);
}

.btn-primary:hover,
.btn-primary:focus-visible,
.btn-outline:hover,
.btn-outline:focus-visible {
  transform: translateY(-1px);
}

.btn-primary:hover,
.btn-primary:focus-visible {
  background: var(--aubergine-soft);
  border-color: var(--orange-bright);
  color: var(--cream);
  box-shadow: 0 0 0 4px rgba(233, 84, 32, 0.16), 0 20px 52px rgba(122, 32, 80, 0.28);
  outline: none;
}

.btn-outline:hover,
.btn-outline:focus-visible {
  background: var(--aubergine-soft);
  border-color: var(--orange-bright);
  color: var(--cream);
  box-shadow: 0 0 0 4px rgba(233, 84, 32, 0.12);
  outline: none;
}

.section-focus {
  background: linear-gradient(180deg, rgba(23, 4, 17, 0), rgba(23, 4, 17, 0.34), rgba(23, 4, 17, 0));
}

.split-section {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(340px, 1.05fr);
  gap: clamp(2.5rem, 7vw, 6rem);
  align-items: center;
}

.split-section.compact {
  align-items: start;
}

.section-copy {
  max-width: 650px;
  margin-top: 1.25rem;
  color: var(--muted);
  font-size: 1.04rem;
}

.venn-panel {
  position: relative;
  min-height: 560px;
}

.venn-desktop {
  position: relative;
  min-height: 520px;
  border: 1px solid rgba(233, 84, 32, 0.18);
  background:
    radial-gradient(circle at 50% 48%, rgba(233, 84, 32, 0.08), transparent 13rem),
    linear-gradient(145deg, rgba(48, 10, 36, 0.34), rgba(23, 4, 17, 0.56));
  box-shadow: inset 0 1px 0 rgba(245, 240, 240, 0.04), 0 28px 90px rgba(0, 0, 0, 0.18);
}

.venn-circle {
  position: absolute;
  display: flex;
  width: 320px;
  height: 320px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  padding: 2.5rem 2rem;
  border: 1px solid rgba(233, 84, 32, 0.5);
  border-radius: 50%;
  background: rgba(48, 10, 36, 0.56);
  color: var(--cream);
  cursor: pointer;
  text-align: center;
  box-shadow: inset 0 0 42px rgba(122, 32, 80, 0.18);
  opacity: 0.86;
  transition: border-color 0.22s, background 0.22s, box-shadow 0.22s, opacity 0.22s, transform 0.22s;
}

.venn-circle span {
  z-index: 2;
  display: block;
  width: min(205px, 78%);
  color: var(--cream);
  font-size: clamp(0.95rem, 1.2vw, 1.18rem);
  font-weight: 700;
  line-height: 1.18;
  transition: color 0.22s, transform 0.22s;
}

.venn-circle ul {
  display: grid;
  width: min(225px, 74%);
  max-height: 0;
  gap: 0.34rem;
  margin-top: 0;
  padding: 0;
  color: var(--muted);
  font-size: clamp(0.82rem, 0.95vw, 0.9rem);
  line-height: 1.35;
  list-style: none;
  opacity: 0;
  overflow: hidden;
  transform: translateY(12px);
  transition: max-height 0.22s, margin-top 0.22s, opacity 0.22s, transform 0.22s;
}

.venn-desktop:has(.venn-circle:hover) .venn-circle:not(:hover),
.venn-desktop:has(.venn-circle:focus-visible) .venn-circle:not(:focus-visible) {
  opacity: 0.56;
}

.venn-circle:hover,
.venn-circle:focus-visible {
  z-index: 6;
  border-color: var(--orange-bright);
  background: rgba(48, 10, 36, 0.98);
  box-shadow: 0 0 0 1px rgba(255, 122, 61, 0.5), 0 0 46px rgba(233, 84, 32, 0.28), inset 0 0 72px rgba(122, 32, 80, 0.34);
  opacity: 1;
  outline: none;
}

.venn-circle:hover span,
.venn-circle:focus-visible span {
  color: var(--orange-bright);
  transform: translateY(-1.1rem);
}

.venn-circle:hover ul,
.venn-circle:focus-visible ul {
  max-height: 7rem;
  margin-top: 0.1rem;
  opacity: 1;
  transform: translateY(0);
}

.venn-circle.systems {
  top: 1rem;
  left: 50%;
  transform: translateX(-50%);
}

.venn-circle.systems:hover,
.venn-circle.systems:focus-visible {
  transform: translateX(-50%) scale(1.1);
}

.venn-circle.behavior {
  bottom: 1.1rem;
  left: 2%;
}

.venn-circle.behavior:hover,
.venn-circle.behavior:focus-visible {
  transform: scale(1.1);
}

.venn-circle.language {
  bottom: 1.1rem;
  right: 2%;
}

.venn-circle.language:hover,
.venn-circle.language:focus-visible {
  transform: scale(1.1);
}

.venn-center {
  position: absolute;
  top: 52%;
  left: 50%;
  z-index: 4;
  width: 210px;
  transform: translate(-50%, -50%);
  color: var(--orange-bright);
  font-family: var(--font-mono);
  font-size: 0.92rem;
  line-height: 1.35;
  pointer-events: none;
  text-align: center;
  text-transform: uppercase;
  text-shadow: 0 0 22px rgba(233, 84, 32, 0.28);
}

.venn-mobile-orbit {
  display: none;
}

.terminal-shell {
  overflow: hidden;
  margin-top: 2rem;
  border: 1px solid rgba(233, 84, 32, 0.28);
  background: linear-gradient(160deg, rgba(6, 2, 5, 0.88), rgba(23, 4, 17, 0.88));
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.28), 0 0 48px rgba(122, 32, 80, 0.18);
}

.terminal-topbar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.85rem 1rem;
  border-bottom: 1px solid rgba(245, 240, 240, 0.1);
  background: linear-gradient(180deg, rgba(75, 18, 55, 0.82), rgba(48, 10, 36, 0.74));
}

.terminal-topbar span {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--orange);
}

.terminal-topbar span:nth-child(2) {
  background: #f4b350;
}

.terminal-topbar span:nth-child(3) {
  background: #72b37e;
}

.terminal-layout {
  display: grid;
  grid-template-columns: 260px 1fr;
  min-height: 360px;
}

.terminal-tabs {
  display: grid;
  align-content: start;
  gap: 0.25rem;
  padding: 1rem;
  border-right: 1px solid rgba(245, 240, 240, 0.1);
}

.terminal-tabs button {
  width: 100%;
  border: 1px solid transparent;
  background: transparent;
  color: var(--dim);
  cursor: pointer;
  padding: 0.75rem;
  text-align: left;
}

.terminal-tabs button:hover,
.terminal-tabs button:focus-visible,
.terminal-tabs button.is-active {
  border-color: rgba(233, 84, 32, 0.36);
  background: rgba(233, 84, 32, 0.06);
  color: var(--orange-bright);
  outline: none;
}

.terminal-output {
  padding: clamp(1.2rem, 4vw, 2rem);
  color: var(--cream);
  font-size: clamp(1rem, 2vw, 1.25rem);
  line-height: 1.8;
}

.terminal-scenario {
  display: none;
}

.terminal-scenario.is-active {
  display: grid;
  gap: 0.65rem;
}

.terminal-output span {
  color: var(--orange-bright);
}

.section-heading-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
  gap: 2rem;
  align-items: end;
}

.section-heading-row p {
  color: var(--muted);
}

.metric-card-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
  margin-top: 3rem;
}

.metric-reveal-card {
  position: relative;
  min-height: 250px;
  overflow: hidden;
  border: 1px solid rgba(233, 84, 32, 0.26);
  background:
    linear-gradient(150deg, rgba(48, 10, 36, 0.62), rgba(23, 4, 17, 0.82));
  color: var(--cream);
  cursor: pointer;
  padding: 1.25rem;
  text-align: center;
  box-shadow: inset 0 1px 0 rgba(245, 240, 240, 0.04);
  transition: border-color 0.2s, transform 0.2s, background 0.2s, box-shadow 0.2s;
}

.metric-reveal-card::before,
.metric-reveal-card::after {
  content: '';
  position: absolute;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.24s;
}

.metric-reveal-card::before {
  top: 16%;
  right: -12%;
  width: 65%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 122, 61, 0.9), transparent);
  transform: rotate(-18deg);
  box-shadow: 0 0 18px rgba(255, 122, 61, 0.38);
}

.metric-reveal-card::after {
  inset: auto -20% -35% -20%;
  height: 70%;
  background: radial-gradient(ellipse at center, rgba(233, 84, 32, 0.18), transparent 65%);
}

.metric-reveal-card:hover,
.metric-reveal-card:focus-visible,
.metric-reveal-card[aria-expanded='true'] {
  border-color: rgba(233, 84, 32, 0.6);
  background:
    radial-gradient(circle at 70% 25%, rgba(233, 84, 32, 0.14), transparent 8rem),
    linear-gradient(150deg, rgba(75, 18, 55, 0.78), rgba(23, 4, 17, 0.9));
  box-shadow: 0 0 0 1px rgba(233, 84, 32, 0.18), 0 0 42px rgba(233, 84, 32, 0.16), inset 0 1px 0 rgba(245, 240, 240, 0.05);
  outline: none;
}

.metric-reveal-card[aria-expanded='true']::before,
.metric-reveal-card:hover::before,
.metric-reveal-card:hover::after,
.metric-reveal-card:focus-visible::before,
.metric-reveal-card:focus-visible::after,
.metric-reveal-card[aria-expanded='true']::after {
  opacity: 1;
}

.metric-front,
.metric-back {
  position: absolute;
  inset: 1.25rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: opacity 0.24s, transform 0.24s;
}

.metric-front strong {
  color: var(--orange-bright);
  font-size: clamp(1.7rem, 3vw, 2.35rem);
  line-height: 1;
}

.metric-front em {
  margin-top: 0.85rem;
  color: var(--muted);
  font-style: normal;
}

.metric-back {
  display: grid;
  align-content: center;
  gap: 0.75rem;
  color: var(--cream);
  line-height: 1.55;
  opacity: 0;
  transform: translateY(12px);
}

.metric-back span {
  display: block;
}

.metric-back strong {
  color: var(--orange-bright);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 400;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.metric-reveal-card:hover .metric-front,
.metric-reveal-card:focus-visible .metric-front,
.metric-reveal-card[aria-expanded='true'] .metric-front {
  opacity: 0;
  transform: translateY(-12px);
}

.metric-reveal-card:hover .metric-back,
.metric-reveal-card:focus-visible .metric-back,
.metric-reveal-card[aria-expanded='true'] .metric-back {
  opacity: 1;
  transform: translateY(0);
}

.before-after-simple {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2rem;
  border-top: 1px solid var(--line);
  padding-top: 1.5rem;
}

.before-after-simple h3 {
  color: var(--orange-bright);
  font-family: var(--font-main);
  font-size: clamp(1.15rem, 1.5vw, 1.35rem);
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.18;
  text-transform: none;
}

.before-after-simple ul,
.email-brief ul {
  display: grid;
  gap: 0.75rem;
  margin-top: 1rem;
  padding-left: 1.1rem;
  color: var(--muted);
}

.ecosystem-relay {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(1rem, 3vw, 2rem);
  margin-top: 3rem;
  padding-top: 5.75rem;
}

.ecosystem-relay::before {
  content: '';
  position: absolute;
  top: 4.25rem;
  right: 12%;
  left: 12%;
  height: 1px;
  background: linear-gradient(90deg, rgba(74, 222, 128, 0.34), rgba(233, 84, 32, 0.6), rgba(143, 131, 139, 0.34));
}

.ecosystem-anchor {
  position: absolute;
  top: 0;
  left: 50%;
  width: min(420px, 100%);
  transform: translateX(-50%);
  color: var(--orange-bright);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  line-height: 1.35;
  text-align: center;
  text-transform: uppercase;
  text-shadow: 0 0 20px rgba(233, 84, 32, 0.24);
}

.ecosystem-link {
  position: relative;
  display: flex;
  min-height: 190px;
  flex-direction: column;
  justify-content: flex-start;
  gap: 0.58rem;
  border-top: 1px solid rgba(233, 84, 32, 0.28);
  background: linear-gradient(180deg, rgba(48, 10, 36, 0.18), rgba(23, 4, 17, 0));
  color: var(--muted);
  padding: 1.45rem 0.35rem 0;
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s, transform 0.2s;
}

.ecosystem-link::before {
  content: '';
  position: absolute;
  top: -1.75rem;
  left: 0;
  width: 0.76rem;
  height: 0.76rem;
  border: 1px solid rgba(233, 84, 32, 0.72);
  border-radius: 50%;
  background: var(--aubergine-deep);
  box-shadow: 0 0 0 6px rgba(233, 84, 32, 0.08), 0 0 18px rgba(233, 84, 32, 0.18);
}

.ecosystem-link[data-node='yassergandhi.dev']::before,
.ecosystem-link[data-node='huhuGERMAN']::before {
  border-color: rgba(74, 222, 128, 0.7);
  box-shadow: 0 0 0 6px rgba(74, 222, 128, 0.08), 0 0 18px rgba(74, 222, 128, 0.12);
}

.ecosystem-link[data-node='Fernweh Together']::before {
  border-color: rgba(143, 131, 139, 0.7);
  box-shadow: 0 0 0 6px rgba(143, 131, 139, 0.08);
}

.ecosystem-context {
  color: var(--orange-bright);
  font-family: var(--font-mono);
  font-size: 0.76rem;
  letter-spacing: 0.08em;
  line-height: 1.25;
  text-transform: uppercase;
}

.ecosystem-link:hover,
.ecosystem-link:focus-visible {
  border-color: rgba(233, 84, 32, 0.58);
  color: var(--cream);
  outline: none;
  transform: translateY(-3px);
}

.ecosystem-link.is-static:hover {
  color: var(--muted);
  transform: none;
}

.ecosystem-link strong {
  color: var(--cream);
  font-size: 1.12rem;
  line-height: 1.25;
}

.status-pill,
.tech-tag {
  display: inline-flex;
  width: fit-content;
  align-items: center;
  gap: 0.42rem;
  border: 1px solid rgba(200, 192, 197, 0.18);
  color: var(--dim);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.08em;
  padding: 0.18rem 0.5rem;
  text-transform: uppercase;
}

.status-pill::before {
  content: '';
  width: 0.42rem;
  height: 0.42rem;
  border-radius: 50%;
  background: var(--dim);
}

.status-pill.live,
.status-pill.proof {
  border-color: rgba(74, 222, 128, 0.24);
  background: var(--green-soft);
  color: var(--green);
}

.status-pill.live::before,
.status-pill.proof::before {
  background: var(--green);
  box-shadow: 0 0 10px rgba(74, 222, 128, 0.36);
}

.status-pill.forthcoming {
  border-color: rgba(200, 192, 197, 0.18);
  background: rgba(200, 192, 197, 0.06);
  color: var(--dim);
}

.ecosystem-line {
  margin-top: 2.5rem;
  color: var(--orange-bright);
  font-family: var(--font-mono);
}

.contact-email {
  padding-bottom: 5rem;
}

.email-brief {
  border-left: 1px solid rgba(233, 84, 32, 0.36);
  padding-left: 1.5rem;
}

.email-brief p:first-child {
  color: var(--orange-bright);
  font-family: var(--font-main);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  text-transform: none;
}

.safety-note {
  margin-top: 1.5rem;
  color: var(--dim);
  font-size: 0.92rem;
}

@media (max-width: 940px) {
  .nav-links {
    display: none;
  }

  .split-section,
  .section-heading-row,
  .terminal-layout,
  .before-after-simple {
    grid-template-columns: 1fr;
  }

  .terminal-tabs {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-right: 0;
    border-bottom: 1px solid rgba(245, 240, 240, 0.1);
  }

  .metric-card-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 680px) {
  .container {
    width: min(100% - 28px, 1120px);
  }

  section {
    padding: 3.75rem 0;
  }

  .section-compact {
    padding: 3rem 0;
  }

  h1 {
    font-size: clamp(2.55rem, 16vw, 4rem);
  }

  .venn-panel {
    min-height: auto;
  }

  .venn-desktop {
    display: none;
  }

  .venn-mobile-orbit {
    position: relative;
    display: block;
    min-height: 340px;
    border: 1px solid rgba(233, 84, 32, 0.18);
    background:
      radial-gradient(circle at 50% 50%, rgba(233, 84, 32, 0.08), transparent 9rem),
      linear-gradient(145deg, rgba(48, 10, 36, 0.28), rgba(23, 4, 17, 0.5));
  }

  .orbit-node {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: min(132px, 35vw);
    min-height: 74px;
    gap: 0.2rem;
    border: 1px solid rgba(233, 84, 32, 0.28);
    border-radius: 999px;
    background: rgba(23, 4, 17, 0.72);
    color: var(--muted);
    padding: 0.62rem;
    text-align: center;
  }

  .orbit-node strong {
    color: var(--cream);
    font-size: 0.86rem;
    line-height: 1.1;
  }

  .orbit-node span {
    color: var(--dim);
    font-size: 0.76rem;
    line-height: 1.15;
  }

  .orbit-center {
    top: 50%;
    left: 50%;
    width: min(158px, 42vw);
    min-height: 88px;
    transform: translate(-50%, -50%);
    color: var(--orange-bright);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .orbit-systems {
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .orbit-behavior {
    bottom: 1rem;
    left: 0.75rem;
  }

  .orbit-language {
    right: 0.75rem;
    bottom: 1rem;
  }

  .orbit-line {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    width: 78px;
    height: 1px;
    border-top: 1px dotted rgba(233, 84, 32, 0.5);
    background: transparent;
    transform-origin: left center;
  }

  .line-systems {
    transform: rotate(-90deg);
  }

  .line-behavior {
    transform: rotate(138deg);
  }

  .line-language {
    transform: rotate(42deg);
  }

  .ecosystem-relay {
    grid-template-columns: 1fr;
    gap: 0;
    margin-top: 2.5rem;
    padding: 4.25rem 0 0 2.25rem;
  }

  .ecosystem-relay::before {
    top: 4.4rem;
    bottom: 0.2rem;
    left: 0.48rem;
    width: 1px;
    height: auto;
    background: linear-gradient(180deg, rgba(74, 222, 128, 0.34), rgba(233, 84, 32, 0.58), rgba(143, 131, 139, 0.34));
  }

  .ecosystem-anchor {
    left: 0;
    width: 100%;
    transform: none;
    text-align: left;
  }

  .ecosystem-link {
    min-height: 0;
    padding: 1.15rem 0 2rem;
  }

  .ecosystem-link::before {
    top: 1.42rem;
    left: -2.25rem;
  }

  .ecosystem-link:hover,
  .ecosystem-link:focus-visible {
    transform: translateX(3px);
  }

  .ecosystem-link.is-static:hover {
    transform: none;
  }

  .terminal-tabs,
  .metric-card-row {
    grid-template-columns: 1fr;
  }

  .metric-reveal-card {
    min-height: 220px;
  }
}

@media (max-width: 410px) {
  .venn-mobile-orbit {
    min-height: 330px;
  }

  .orbit-node {
    width: min(124px, 34vw);
    min-height: 70px;
    padding: 0.56rem;
  }

  .orbit-node strong {
    font-size: 0.82rem;
  }

  .orbit-node span {
    font-size: 0.76rem;
  }

  .orbit-center {
    width: min(148px, 40vw);
    min-height: 84px;
    font-size: 0.76rem;
  }

  .orbit-behavior {
    left: 0.45rem;
  }

  .orbit-language {
    right: 0.45rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
